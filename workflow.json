        "jsCode": "const rawText = $json.text || \"\";\n\n// Remove Slack mention like <@U123ABC>\nconst cleaned = rawText.replace(/<@[^>]+>\\s*/, \"\").trim();\n\n// Split by pipe\nconst parts = cleaned.split(\"|\").map(p => p.trim());\n\n// Map fields\nconst summary = parts[0] || \"\";\nconst description = parts[1] || \"\";\nconst priorityInput = (parts[2] || \"\").toLowerCase();\n\n// Normalize priority for Jira\nlet priority = \"Medium\";\nif (priorityInput === \"high\") priority = \"High\";\nelse if (priorityInput === \"low\") priority = \"Low\";\nelse if (priorityInput === \"critical\") priority = \"Highest\";\nelse if (priorityInput === \"medium\") priority = \"Medium\";\n\nreturn [\n  {\n    json: {\n      summary,\n      description,\n      priority,\n      original_text: rawText,\n      cleaned_text: cleaned,\n      slack_user: $json.user,\n      slack_channel: $json.channel,\n      slack_ts: $json.ts\n    }\n  }\n];"
